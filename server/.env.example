# Server Environment Variables

# Server Port
PORT=5000

# JWT Authentication Secret (Use a strong random secret in production)
JWT_SECRET=msbte_feedback_secret_2024

# Node Environment
NODE_ENV=production

# Frontend Client URL (For Render deployment CORS)
CLIENT_URL=https://your-frontend-app.onrender.com

# --- OPTION 1: Supabase / PostgreSQL (Recommended for Render) ---
# Copy from Supabase Project Settings -> Database -> Connection URI
DATABASE_URL=postgresql://postgres.xxxx:your_supabase_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- OPTION 2: Local MySQL (For Local Development) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=college_feedback
